{
  "name": "asher-electron",
  "version": "2.1.0",
  "description": "Electron frontend for Asher (JSONL transport to Asher.Host)",
  "private": true,
  "main": "src/main/main.js",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/MikeMequis/Asher.git"
  },
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "build:host": "node scripts/build-host.mjs Release",
    "build:host:debug": "node scripts/build-host.mjs Debug",
    "clean:dist": "node scripts/clean-dist.mjs",
    "sync:distribution": "node scripts/sync-distribution.mjs",
    "build:host:linux": "DOTNET_SYSTEM_GLOBALIZATION_INVARIANT=1 dotnet publish ../Asher.Host/Asher.Host.csproj -c Release -r linux-x64 --self-contained true -p:Platform=AnyCPU -p:InvariantGlobalization=true -o build/linux-host",
    "stage:linux-payload": "node scripts/stage-linux-payload.mjs",
    "verify:linux": "node scripts/verify-linux-package.mjs",
    "dist:linux": "bash scripts/build-linux.sh",
    "dist:linux:publish": "PUBLISH=always bash scripts/build-linux.sh",
    "publish:linux": "node scripts/load-gh-token.mjs npm run dist:linux:publish",
    "dist": "npm run clean:dist && npm run build:host && electron-builder --win dir zip nsis --ia32 && npm run sync:distribution",
    "publish": "node scripts/load-gh-token.mjs npm run dist:publish",
    "dist:publish": "npm run clean:dist && npm run build:host && electron-builder --win dir zip nsis --ia32 --publish always && npm run sync:distribution",
    "smoke": "node scripts/smoke-test.mjs",
    "smoke:setup": "node scripts/setup-smoke-test.mjs",
    "smoke:manager": "node scripts/manager-smoke-test.mjs",
    "smoke:shell": "node scripts/shell-smoke-test.mjs",
    "smoke:install": "node scripts/install-smoke-test.mjs",
    "smoke:uninstall": "node scripts/uninstall-smoke-test.mjs",
    "smoke:launch": "node scripts/launch-smoke-test.mjs",
    "smoke:payload": "node scripts/payload-smoke-test.mjs",
    "smoke:platform": "node scripts/platform-smoke-test.mjs",
    "smoke:preflight": "node scripts/preflight-smoke-test.mjs"
  },
  "build": {
    "appId": "com.asher.manager",
    "productName": "Asher",
    "afterPack": "scripts/after-pack-linux.cjs",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "dir",
        "zip",
        "nsis"
      ],
      "artifactName": "Asher-${version}-win32.${ext}",
      "signAndEditExecutable": false,
      "extraResources": [
        {
          "from": "../Asher.Host/bin/x86/Release/net8.0",
          "to": "asher-host",
          "filter": [
            "**/*",
            "!**/*.pdb",
            "!**/settings.json"
          ]
        }
      ]
    },
    "nsis": {
      "artifactName": "Asher-Setup-${version}.${ext}"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "tar.gz",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Utility",
      "executableName": "Asher",
      "artifactName": "${productName}-${version}-linux-${arch}.${ext}",
      "extraResources": [
        {
          "from": "build/linux-host",
          "to": "asher-host",
          "filter": [
            "**/*",
            "!**/*.pdb",
            "!**/settings.json"
          ]
        }
      ]
    },
    "publish": [
      {
        "provider": "github",
        "owner": "MikeMequis",
        "repo": "Asher"
      }
    ]
  },
  "devDependencies": {
    "electron": "^35.0.0",
    "electron-builder": "^25.1.8",
    "electron-updater": "^6.8.9"
  }
}
